{
  "name": "binh-loi-english-quest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @bleq/frontend --",
    "dev:backend": "npm run dev --workspace @bleq/backend",
    "build": "npm run build --workspaces",
    "preview": "npm run preview --workspace @bleq/frontend --",
    "test": "npm run test --workspaces",
    "test:e2e": "playwright test",
    "format": "prettier --write frontend backend tests *.ts *.json README.md",
    "start": "npm run start --workspace @bleq/backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "prettier": "^3.9.10"
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}
